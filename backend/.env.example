PORT=5000
NODE_ENV=production

# Database Config (PostgreSQL ONLY)
PGHOST=your-supabase-db-host.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your-secure-rotated-database-password

# JWT Config (DO NOT commit secrets to repository)
JWT_ACCESS_SECRET=your-random-generated-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-random-generated-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# SYSTEM Config
SYSTEM_TIMEZONE=Asia/Kolkata

# Cloudflare R2 Config (Optional, set STORAGE_PROVIDER=r2 to activate)
STORAGE_PROVIDER=db
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET=guard-photos
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://pub-<your-unique-id>.r2.dev

# Supabase Auth/Storage Credentials (For file storage bucket if STORAGE_PROVIDER is not set)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-secret
